# =====================================================================
#  הגדרות המערכת — המקום היחיד שבו מגדירים חיבורים.
#  העתיקו את הקובץ הזה לקובץ בשם ‎.env‎ ומלאו את הערכים.
#  כל עוד שדות Microsoft ריקים — המערכת רצה במצב הדגמה.
# =====================================================================

# בסיס הנתונים. בהדגמה: קובץ מקומי. בפריסה: כתובת PostgreSQL.
DATABASE_URL="file:./data/dev.db"

# מפתח סודי להצפנת חיבורי המשתמשים (מחרוזת אקראית ארוכה).
SESSION_SECRET="change-me-to-a-long-random-string"

# ---- Microsoft 365 (יוגדר בסוף הפיתוח) ----
# מזהה הארגון (Tenant ID) מתוך Microsoft Entra ID
MS_TENANT_ID=""
# מזהה האפליקציה (Application / Client ID)
MS_CLIENT_ID=""
# סוד האפליקציה (Client Secret)
MS_CLIENT_SECRET=""
# כתובת המייל שממנה המערכת שולחת הודעות
MAIL_FROM=""

# ---- הצהרת נגישות ----
ACCESSIBILITY_COORDINATOR_NAME=""
ACCESSIBILITY_COORDINATOR_EMAIL=""
ACCESSIBILITY_COORDINATOR_PHONE=""
